# Скопируйте этот файл в .env (корень репозитория) и задайте свой пароль.
# docker compose читает .env из корня; тот же пароль должен быть в apps/server/.env.
#
# Для существующего volume с прежним паролем сначала выполните:
#   docker exec -it penknife-db psql -U penknife -d penknife -c "ALTER USER penknife WITH PASSWORD 'новый-пароль';"
POSTGRES_PASSWORD=change-me
