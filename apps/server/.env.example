# Скопируйте этот файл в .env и при необходимости измените значения

DATABASE_URL="postgresql://penknife:penknife@localhost:5432/penknife?schema=public"

# Слушать только локально (в Docker укажите HOST=0.0.0.0)
HOST=127.0.0.1
PORT=3001

# Разрешённые источники для CORS (через запятую). В проде можно оставить пустым:
# same-origin запросы работают без него.
CORS_ORIGINS=http://localhost:5173

# Срок жизни сессии в днях
SESSION_TTL_DAYS=7

# Имя cookie сессии (менять не нужно)
# SESSION_COOKIE_NAME=penknife_sid

# auto | true | false. auto = Secure только при NODE_ENV=production.
# Для демо по обычному http без TLS задайте false, иначе браузер не сохранит cookie.
COOKIE_SECURE=auto

# 1, если сервер стоит за nginx/прокси (нужно для корректного IP в rate limit)
TRUST_PROXY=0

# Ключ для обратимого шифрования паролей (показ пароля в админ-панели).
# Любая длинная случайная строка. Если не задан — показ пароля отключён.
PASSWORD_ENCRYPTION_KEY=change-me-to-a-long-random-string

