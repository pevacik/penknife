generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String         @id @default(uuid())
  title             String         @default("Новая карточка")
  price             Int            @default(0)
  circulation       String         @default("")
  make50            Boolean        @default(false)
  productionCountry String         @default("russia")
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  images            ProductImage[]
  comments          Comment[]
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Comment {
  id        String         @id @default(uuid())
  title     String
  text      String         @default("")
  createdAt DateTime       @default(now())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    CommentImage[]

  @@index([productId])
}

model CommentImage {
  id        String  @id @default(uuid())
  url       String
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}
